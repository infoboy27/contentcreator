{"id": "contentCreatorNotifyTelegram01", "name": "ContentCreator - Aviso Telegram", "description": "Recibe avisos de contentcreator-site (POST /webhook/contentcreator-notify con x-internal-token) y los envia al chat de Telegram en HTML.", "active": false, "isArchived": false, "nodes": [{"parameters": {"httpMethod": "POST", "path": "contentcreator-notify", "responseMode": "onReceived", "options": {}}, "id": "c1a11111-1111-4111-8111-111111111111", "name": "Webhook aviso", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "c1a11111-1111-4111-8111-11111111aaaa"}, {"parameters": {"jsCode": "// Solo acepta avisos de ContentCreator (mismo token interno que usa el resto de flujos).\nconst headers = $json.headers || {};\nif (headers['x-internal-token'] !== $env.CONTENTCREATOR_INTERNAL_TOKEN) return [];\nconst text = String($json.body?.text || '').slice(0, 4000);\nif (!text) return [];\nreturn [{ json: { text } }];"}, "id": "c2b22222-2222-4222-8222-222222222222", "name": "Validar aviso", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [260, 0]}, {"parameters": {"method": "POST", "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text, parse_mode: 'HTML', disable_web_page_preview: true } }}", "options": {"timeout": 15000}}, "id": "c3c33333-3333-4333-8333-333333333333", "name": "Enviar a Telegram", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [520, 0], "continueOnFail": true}], "connections": {"Webhook aviso": {"main": [[{"node": "Validar aviso", "type": "main", "index": 0}]]}, "Validar aviso": {"main": [[{"node": "Enviar a Telegram", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1", "timezone": "America/Santo_Domingo"}, "staticData": null, "pinData": {}, "tags": []}