));\nreturn [{ json: { message: lines.join('\\n') } }];"},"id":"3bf38158-4acf-4637-8d33-28968c4965ac","name":"Preparar mensaje","type":"n8n-nodes-base.code","typeVersion":2,"position":[540,90]},{"parameters":{"method":"POST","url":"=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage","sendBody":true,"specifyBody":"json","jsonBody":"={{ { chat_id: $env.TELEGRAM_CHAT_ID, text: $json.message, parse_mode: 'HTML', disable_web_page_preview: true } }}"},"id":"96bb1a1d-9a56-4c3e-979e-5ea29697533b","name":"Enviar Telegram","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[800,90]}],"connections":{"Cada dia 8:30 AM":{"main":[[{"node":"Obtener plan","type":"main","index":0}]]},"Ejecutar manualmente":{"main":[[{"node":"Obtener plan","type":"main","index":0}]]},"Obtener plan":{"main":[[{"node":"Preparar mensaje","type":"main","index":0}]]},"Preparar mensaje":{"main":[[{"node":"Enviar Telegram","type":"main","index":0}]]}},"settings":{"timezone":"America/Santo_Domingo","errorWorkflow":"errorNotifierTelegram01","executionOrder":"v1"},"staticData":null,"meta":{},"nodeGroups":[],"pinData":{},"versionId":"43c303d0-2e17-4043-9b04-6e87492ca87f","activeVersionId":"43c303d0-2e17-4043-9b04-6e87492ca87f","versionCounter":6,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-07-29T22:16:02.446Z","createdAt":"2026-07-29T22:16:02.446Z","role":"workflow:owner","workflowId":"multiplatformContentPlanDaily01","projectId":"TxrzLSDok85IEqL0","project":{"updatedAt":"2026-07-29T03:34:51.567Z","createdAt":"2026-07-29T02:45:42.168Z","id":"TxrzLSDok85IEqL0","name":"Jonatan Maria <jmservicedo@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"39f38987-5306-44c4-9238-628437f7dea3"}}],"versionMetadata":{"name":null,"description":null}}