{"updatedAt":"2026-07-31T12:58:14.175Z","createdAt":"2026-07-30T18:48:23.003Z","id":"facebookPostsTelegram01","name":"ContentCreator - Posts Facebook","description":null,"active":false,"isArchived":false,"nodes":[{"id":"8c5cec84-de15-4847-a5e1-cbd1f5e92721","name":"Post webhook interno","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"webhookId":"contentcreator-facebook-post-command","parameters":{"httpMethod":"POST","path":"contentcreator-facebook-post-command","responseMode":"responseNode","options":{}}},{"id":"48392823-eae1-478b-a8df-b5b1b681f8bc","name":"Leer comando","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,0],"parameters":{"jsCode":"const envelope = $json;\nif (envelope.headers?.['x-internal-token'] !== $env.CONTENTCREATOR_INTERNAL_TOKEN) throw new Error('Solicitud interna no autorizada.');\nconst update = envelope.body || envelope;\nconst message = update.message || update.edited_message || {};\nconst text = String(message.text || '').trim();\nconst chatId = message.chat?.id || $env.TELEGRAM_CHAT_ID;\nconst updateId = update.update_id ?? update.updateId ?? null;\nconst messageId = message.message_id ?? message.messageId ?? null;\nconst requestId = ['telegram', chatId, updateId ?? 'no-update', messageId ?? 'no-message'].join(':');\nconst preparePost = /^PREPARAR\\s+POST\\b/i.test(text);\nconst approvePost = /^APROBAR\\s+(?:POST\\s+)?PST-/i.test(text);\nconst rejectContent = /^RECHAZAR\\s+PST-/i.test(text);\nreturn [{ json: { preparePost, approvePost, rejectContent, chatId, text, updateId, messageId, requestId } }];"}},{"id":"51d6ce65-94a1-481b-a293-926e52ea8d09","name":"Es PREPARAR POST","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[780,180],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"prepare-post-if-01-condition","leftValue":"={{ $json.preparePost }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"f6deea87-df05-4f90-9f5e-7fa79bb1dbb3","leftValue":"={{ $json.approvePost }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"a6848d39-1aa9-4785-ae61-37359880082e","name":"Es APROBAR POST","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[780,160]},{"id":"e8519394-0c7d-4a6d-a163-a1704d1b1ce5","name":"Es RECHAZAR POST","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1040,260],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"c6533889-c7b0-47d8-abe3-6cde3ffa9dc8","leftValue":"={{ $json.rejectContent }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"550b5992-ec43-47b6-adca-004a317a7f0c","name":"Preparar preview post","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1040,240],"parameters":{"method":"POST","url":"http://contentcreator-site:3000/api/content/prepare-facebook-post","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-internal-token","value":"={{ $env.CONTENTCREATOR_INTERNAL_TOKEN }}"},{"name":"content-type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { command: $('Leer comando').first().json.text, requestId: $('Leer comando').first().json.requestId } }}","options":{"timeout":300000,"response":{"response":{"neverError":true}}}}},{"id":"fb7a0912-3ed4-4645-add4-c6853f31749d","name":"Preparar respuesta preview post","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,240],"parameters":{"jsCode":"const result = $json;\nif (result.duplicate || result.suppress_message) return [{ json: { suppress_message: true, photo: null, caption: '', message: '' } }];\nif (result.telegram?.send_media === false) return [{ json: { suppress_message: true, photo: null, caption: '', message: '' } }];\nif (!result.ok) { const message = 'No pude preparar el post.\\n' + (result.error || 'Error desconocido.'); return [{ json: { suppress_message: false, photo: null, caption: message, message } }]; }\nconst post = result.post || {};\nconst caption = ['PREVIEW DE POST - NO PROGRAMADO', '', 'ID: ' + (result.contentId || post.contentId), 'Pagina: ' + (post.pageName || 'N/D'), '', post.content || '', '', 'APROBAR ' + (result.contentId || post.contentId), 'RECHAZAR ' + (result.contentId || post.contentId)].join('\\n');\nreturn [{ json: { suppress_message: false, photo: post.imagePath || null, caption, message: caption, content_id: result.contentId || post.contentId } }];"}},{"id":"ef5505d7-456a-4bb0-a5ec-1b8b37460d70","name":"Debe enviar preview post","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1560,240],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"send-post-preview-if-01-condition","leftValue":"={{ !$json.suppress_message }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"1f4d63ea-a10f-4bd9-a5c9-12620ae3e13b","name":"Tiene foto preview post","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1690,240],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"post-preview-has-photo-01-condition","leftValue":"={{ Boolean($json.photo) }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"8bd9f58d-5d1a-4c1e-a13e-7b2f92b920e0","name":"Enviar preview post","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1820,240],"parameters":{"method":"POST","url":"={{ \"https://api.telegram.o