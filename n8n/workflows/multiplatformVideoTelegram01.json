{"updatedAt":"2026-07-31T13:46:05.734Z","createdAt":"2026-07-30T18:48:18.406Z","id":"multiplatformVideoTelegram01","name":"ContentCreator - Videos multiplataforma","description":null,"active":true,"isArchived":false,"nodes":[{"id":"a0e66c0c-1d57-4891-a202-8aa7681d702a","name":"Video webhook interno","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"webhookId":"contentcreator-video-command","parameters":{"httpMethod":"POST","path":"contentcreator-video-command","responseMode":"responseNode","options":{}}},{"id":"0cc6bdd0-9b87-407c-a6a6-8b21ce25c5b1","name":"Leer comando","type":"n8n-nodes-base.code","typeVersion":2,"position":[260,0],"parameters":{"jsCode":"const envelope = $json;\nif (envelope.headers?.['x-internal-token'] !== $env.CONTENTCREATOR_INTERNAL_TOKEN) throw new Error('Solicitud interna no autorizada.');\nconst update = envelope.body || envelope;\nconst message = update.message || update.edited_message || {};\nconst text = String(message.text || '').trim();\nconst chatId = message.chat?.id || $env.TELEGRAM_CHAT_ID;\nconst updateId = update.update_id ?? update.updateId ?? null;\nconst messageId = message.message_id ?? message.messageId ?? null;\nconst requestId = ['telegram', chatId, updateId ?? 'no-update', messageId ?? 'no-message'].join(':');\nconst publishVideo = /^APROBAR\\s+(?:VIDEO|REEL|VID-)/i.test(text);\nconst generateVideo = /^(?:GENERAR|PREVIEW)\\s+(?:VIDEO|REEL)\\b/i.test(text);\nconst rejectContent = /^RECHAZAR\\s+VID-/i.test(text);\nreturn [{ json: { publishVideo, generateVideo, rejectContent, chatId, text, updateId, messageId, requestId } }];"}},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"79bbeb0f-a115-45f6-bd45-24f6b823bc55","leftValue":"={{ $json.publishVideo }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"6665644d-5c5b-448d-abe3-75b2e2110cc3","name"