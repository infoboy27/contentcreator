egram = data.telegram || {};\nconst tiktok = data.tiktok || {};\nif (data.duplicate) return [{ json: { text: '', video_url: null, caption: '', send_video: false, suppress_message: true } }];\nconst lines = [];\nif (!data.ok) { lines.push('No pude procesar el video.'); lines.push(data.error || 'Error desconocido.'); return [{ json: { text: lines.join('\\n'), video_url: null, caption: '', send_video: false, suppress_message: false } }]; }\nconst mode = data.mode || 'preview';\nif (mode === 'published') lines.push('Video aprobado y publicado correctamente.');\nelse if (mode === 'already_published') lines.push('Este video ya estaba publicado.');\nelse if (mode === 'preview_existing') lines.push('Ya existe un preview pendiente para este tema.');\nelse lines.push('Preview producido. NO publicado.');\nlines.push('');\nlines.push('ID: ' + (data.contentId || video.contentId || 'N/D'));\nlines.push('Marca: ' + (video.displayBrand || 'N/D'));\nlines.push('Destino: ' + (video.destination || 'N/D'));\nlines.push('Version: ' + (video.generation_version || 1) + (video.supersedes_content_id ? ' (reemplaza el rechazado ' + video.supersedes_content_id + ')' : ''));\nlines.push('Duracion video: ' + (video.duration || 'N/D') + 's');\nlines.push('Narracion real: ' + (video.speech_duration ? Number(video.speech_duration).toFixed(1) + 's' : 'N/D'));\nlines.push('Guion: ' + (video.script_quality?.word_count || 'N/D') + ' palabras, modelo ' + (video.script_model || 'N/D'));\nlines.push('Calidad: ' + (video.quality?.passed ? 'validada' : 'pendiente'));\nlines.push('Facebook Reel: ' + (facebook.ok ? 'publicado' : (facebook.skipped ? 'omitido - ' + facebook.reason : 'fallo' + (facebook.error ? ' - ' + facebook.error : ''))));\nlines.push('YouTube: ' + (youtube.ok ? 'subido' : (youtube.skipped ? 'omitido - ' + youtube.reason : 'fallo' + (youtube.error ? ' - ' + youtube.error : ''))));\nlines.push('TikTok: ' + (tiktok.reason || 'Solo Vida con Dios usa MP4 manual.'));\nif (mode !== 'published' && video.contentId) { lines.push(''); lines.push('APROBAR ' + video.contentId); lines.push('RECHAZAR ' + video.contentId); }\nlines.push('');\nlines.push(video.video_url || 'Sin URL de video.');\nconst sendVideo = Boolean(video.video_url && (telegram.send_video ?? mode === 'preview'));\nreturn [{ json: { text: lines.join('\\n'), video_url: video.video_url || null, caption: video.description || '', content_id: video.contentId || data.contentId || null, send_video: sendVideo, suppress_message: false } }];"},"id":"5dcc3824-e57e-4e1f-ac7e-c54182c52735","name":"Preparar respuesta publicacion","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,-100]},{"id":"61bcc132-1ead-494a-a163-9eadfd46cf3a","name":"Debe enviar respuesta publicacion","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1560,-100],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"b2efaafb-b1e0-455f-85f0-f427f1471152","leftValue":"={{ $json.suppress_message }}","rightValue":true,"operator":{"type":"boolean","operation":"false","singleValue":true}}],"combinator":"and"},"options":{}}},{"parameters":{"method":"POST","url":"=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage","sendBody":true,"specifyBody":"json","jsonBody":"={{ { chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text || $json.message, disable_web_page_preview: true } }}"},"id":"be63f9b4-780f-432a-a3f6-df649450fceb","name":"Enviar Telegram publicacion","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1560,-160]},{"id":"75a2ee10-290f-435e-a17e-89a742eba055","name":"Debe enviar video manual","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1820,-160],"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"b9578c0d-aaa8-4ecd-867d-a236444c3608","leftValue":"={{ $('Preparar respuesta publicacion').first().json.send_video }}","rightVal