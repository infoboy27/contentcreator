# Copia este archivo a .env (scripts/install.sh lo hace y genera las claves).
# Nunca subas el .env al repositorio.

# --- Equipo ---
# amd (ROCm + Vulkan, la configuración de referencia) o nvidia (CUDA + Vulkan, sin probar)
GPU_VENDOR=amd
# Solo para RX 6700 XT / 6750 XT (gfx1031); déjalo vacío en otras tarjetas.
HSA_OVERRIDE_GFX_VERSION=10.3.0
# IDs de los grupos video y render del host (install.sh los detecta).
VIDEO_GID=44
RENDER_GID=991
TZ=America/Santo_Domingo

# --- ContentCreator ---
# URL pública del Studio (por Cloudflare Tunnel o Traefik). Debe coincidir con el redirect de Google OAuth.
APP_BASE_URL=https://contentcreator.example.com
DATA_DIR=/app/data
PORT=3000
# Clave del panel /studio (install.sh la genera).
STUDIO_PASSWORD=
# Token compartido entre n8n y ContentCreator (install.sh lo genera).
CONTENTCREATOR_INTERNAL_TOKEN=

# --- IA ---
# local: voz, imágenes y subtítulos con la GPU. El guion puede ir aparte:
AI_PROVIDER=local
# openai (mejor redacción, centavos por video) o local (gratis, qwen3.5:9b)
AI_SCRIPT_PROVIDER=openai
# Si algo local falla, usar OpenAI de respaldo (requiere OPENAI_API_KEY).
AI_FALLBACK_OPENAI=true
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OLLAMA_SCRIPT_MODEL=qwen3.5:9b
# Velocidad inicial de la voz por canal (luego se ajusta desde Studio → Ajustes).
VOICE_SPEED_RELIGIOSO=0.9
VOICE_SPEED_PELICULAS=0.98

# --- YouTube (Google Cloud → OAuth client "Web application") ---
# Redirect URI autorizado: ${APP_BASE_URL}/youtube/callback
# IMPORTANTE: publica la app ("In production") o los permisos caducan cada 7 días.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Facebook ---
FACEBOOK_PUBLISHING_ENABLED=false

# --- n8n + Telegram ---
# Token de @BotFather y tu chat ID (el bot solo responde a ese chat).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL pública de n8n (para el webhook de Telegram), p. ej. https://automation.example.com
N8N_PUBLIC_URL=
N8N_HOST=automation.example.com
N8N_ENCRYPTION_KEY=

# --- Cloudflare Tunnel (opcional, perfil "tunnel") ---
CLOUDFLARE_TUNNEL_TOKEN=
